---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { categoryList } from "@/data/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.categoriesTitle} | ${config.site.title}`}
  description={t.pages.categoriesDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        categoryList.map(category => (
          <a
            href={`/categories/${category.slug}/`}
            class="border-border rounded-2xl border p-5 no-underline transition hover:border-accent"
          >
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-bold">{category.name}</h2>
              <span class="text-accent" aria-hidden="true">→</span>
            </div>
            <p class="text-muted-foreground mt-3 leading-7">
              {category.description}
            </p>
            <p class="mt-4 text-sm font-semibold">
              시작 지역: {category.launchRegions.join(" · ")}
            </p>
          </a>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
