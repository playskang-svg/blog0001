---
import { resolvePlacement, type ProductKind } from "@/data/affiliate-catalog";

type Props = {
  placementKeys: string[];
  title?: string;
  intro?: string;
  emptyMessage?: string;
};

const {
  placementKeys,
  title = "이 동선에 맞는 숙소 선택",
  intro = "아래 숙소는 유명도보다 이동 동선과 환승 부담을 기준으로 분류합니다.",
  emptyMessage,
} = Astro.props;

const stayKinds: ProductKind[] = ["hotel", "guesthouse", "vacation-rental"];
const resolvedItems = placementKeys
  .map(resolvePlacement)
  .filter(item => item && stayKinds.includes(item.product.kind));

// 등록되지 않은 키는 링크를 추측하지 않고 표시 대상에서 제외합니다.
---

{
  resolvedItems.length > 0 && (
    <aside class="not-prose my-10">
      <div class="mb-5">
        <p class="text-accent mb-2 text-sm font-semibold">숙박 거점 결정</p>
        <h2 class="text-foreground text-2xl font-bold">{title}</h2>
        <p class="text-muted-foreground mt-2 leading-7">{intro}</p>
      </div>

      {resolvedItems.some(item => item?.offer?.commissioned) && (
        <p class="border-border bg-muted/30 text-foreground mb-4 rounded-lg border px-4 py-3 text-sm leading-6">
          이 영역에는 제휴 링크가 포함되어 있으며, 예약이 이루어지면
          팁스피디아가 수수료를 받을 수 있습니다.
        </p>
      )}

      <div class="grid gap-4 sm:grid-cols-2">
        {resolvedItems.map(
          item =>
            item && (
              <article class="border-border rounded-2xl border p-5">
                <p class="text-muted-foreground text-sm">
                  {item.product.region}
                </p>
                <h3 class="text-foreground mt-1 text-lg font-bold">
                  {item.product.name}
                </h3>
                <p class="text-foreground mt-3 leading-7">
                  {item.product.decisionReason}
                </p>
                <p class="text-muted-foreground mt-2 text-sm leading-6">
                  {item.product.locationNote}
                </p>
                {item.offer && (
                  <a
                    href={item.offer.url}
                    target="_blank"
                    rel={
                      item.offer.commissioned
                        ? "sponsored noopener noreferrer"
                        : "noopener noreferrer"
                    }
                    class="text-accent mt-4 inline-flex min-h-11 items-center font-semibold underline decoration-dashed underline-offset-4"
                  >
                    예약 조건 확인
                    <span aria-hidden="true" class="ms-1">
                      ↗
                    </span>
                  </a>
                )}
              </article>
            )
        )}
      </div>
    </aside>
  )
}

{
  resolvedItems.length === 0 && emptyMessage && (
    <aside class="not-prose border-border bg-muted/25 my-10 rounded-2xl border border-dashed p-5 sm:p-6">
      <p class="text-accent text-sm font-semibold">숙박 거점 결정</p>
      <h2 class="text-foreground mt-1 text-xl font-bold">{title}</h2>
      <p class="text-muted-foreground mt-3 leading-7">{emptyMessage}</p>
    </aside>
  )
}
